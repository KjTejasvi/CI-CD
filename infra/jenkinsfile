pipeline {
    parameters {
        choice(name: 'terraformAction', choices: ['apply', 'destroy'], description: 'Choose your Terraform action')
    }

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
    }

    agent any

    stages {
        
        stage('Checkout') {
            steps {
                dir('terraform') {
                    git url: 'https://github.com/KjTejasvi/CI-CD.git', branch: 'project1'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('terraform/infra') {
                    sh 'terraform init'
                    sh 'terraform plan -out=tfplan -input=false'
                    sh 'terraform show -no-color tfplan > tfplan.txt'
                }
            }
        }

        stage('Apply or Destroy') {
            when {
                expression {
                    params.terraformAction == 'apply' || params.terraformAction == 'destroy'
                }
            }
            steps {
                script {
                    if (params.terraformAction == 'apply') {
                        dir('terraform/infra') {
                            sh 'terraform apply -input=false tfplan'
                        }
                    } else if (params.terraformAction == 'destroy') {
                        dir('terraform/infra') {
                            sh 'terraform destroy -auto-approve'
                        }
                    }
                }
            }
        }

    }
}
